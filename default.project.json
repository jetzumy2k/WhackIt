        "$className": "Folder",
        "$path": { "optional": "src/gui/screens" }
      }
    },

    "Workspace": {
      "$properties": {
        "FallenPartsDestroyHeight": -60
      },

      "Arena": {
        "$className": "Folder",

        "Floor": {
          "$className": "Part",
          "$properties": {
            "Anchored": true,
            "Size": [180, 1, 90],
            "Position": [0, -0.5, -10],
            "Material": "Slate",
            "Color": [0.24, 0.25, 0.3],
            "TopSurface": "Smooth"
          }
        },

        "SpawnLocation": {
          "$className": "SpawnLocation",
          "$properties": {
            "Anchored": true,
            "Size": [6, 1, 6],
            "Position": [0, 0.5, 20],
            "Duration": 0,
            "TopSurface": "Smooth"
          }
        }
      }
    },

    "Lighting": {
      "$properties": {
        "Brightness": 1.5,
        "ExposureCompensation": -0.25,
        "Ambient": [0.27, 0.27, 0.31],
        "OutdoorAmbient": [0.45, 0.45, 0.5],
        "ClockTime": 15,
        "GlobalShadows": true
      }
    },

    "SoundService": {
      "$properties": {
        "RespectFilteringEnabled": true
      }
    }
