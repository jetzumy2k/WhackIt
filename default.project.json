{
  "name": "WhackItOut",
  "tree": {
    "$className": "DataModel",

    "ReplicatedStorage": {
      "Packages": {
        "$className": "Folder",
        "$path": { "optional": "Packages" }
      },

      "Shared": {
        "$path": "src/shared"
      },

      "Config": {
        "$path": "src/config"
      },

      "Remotes": {
        "$className": "Folder",

        "Combat": {
          "$className": "Folder",

          "RequestHammerHit": {
            "$className": "RemoteEvent"
          },

          "CombatFeedback": {
            "$className": "RemoteEvent"
          },

          "BossDefeated": {
            "$className": "RemoteEvent"
          }
        },

        "Shop": {
          "$className": "Folder",

          "BuyHammer": {
            "$className": "RemoteEvent"
          },

          "EquipHammer": {
            "$className": "RemoteEvent"
          }
        },

        "Profile": {
          "$className": "Folder",

          "Sync": {
            "$className": "RemoteEvent"
          }
        }
      }
    },

    "ServerScriptService": {
      "Main": {
        "$path": "src/server/Main.server.luau"
      },

      "Config": {
        "$className": "Folder",
        "$path": { "optional": "src/server/config" }
      },

      "ServerPackages": {
        "$className": "Folder",
        "$path": { "optional": "ServerPackages" }
      },

      "Lib": {
        "$className": "Folder",
        "$path": { "optional": "src/server/lib" }
      },

      "Services": {
        "$className": "Folder",
        "$path": { "optional": "src/server/services" }
      },

      "Controllers": {
        "$className": "Folder",
        "$path": { "optional": "src/server/controllers" }
      }
    },

    "StarterPlayer": {
      "StarterPlayerScripts": {
        "Main": {
          "$path": "src/client/Main.client.luau"
        },

        "Lib": {
          "$className": "Folder",
          "$path": { "optional": "src/client/lib" }
        },

        "Controllers": {
          "$className": "Folder",
          "$path": { "optional": "src/client/controllers" }
        }
      }
    },

    "StarterGui": {
      "Screens": {
        "$className": "Folder",
        "$path": { "optional": "src/gui/screens" }
      }
    },

    "Workspace": {
      "Arena": {
        "$className": "Folder",

        "Floor": {
          "$className": "Part",
          "$properties": {
            "Anchored": true,
            "Size": [128, 1, 128],
            "Position": [0, -0.5, 0],
            "Material": "Grass",
            "Color": [0.38, 0.69, 0.33],
            "TopSurface": "Smooth"
          }
        },

        "SpawnLocation": {
          "$className": "SpawnLocation",
          "$properties": {
            "Anchored": true,
            "Size": [6, 1, 6],
            "Position": [0, 0.5, 10],
            "Duration": 0,
            "TopSurface": "Smooth"
          }
        }
      }
    },

    "Lighting": {
      "$properties": {
        "Brightness": 2,
        "GlobalShadows": true
      }
    },

    "SoundService": {
      "$properties": {
        "RespectFilteringEnabled": true
      }
    }
  }
}