{
  "name": "WhackItOut",
  "tree": {
    "$className": "DataModel",

    "ReplicatedStorage": {
      "Packages": {
        "$className": "Folder",
        "$path": { "optional": "Packages" }
      },

      "Shared": {
        "$path": "src/shared"
      },

      "Config": {
        "$path": "src/config"
      },

      "Remotes": {
        "$className": "Folder",

        "Combat": {
          "$className": "Folder",

          "RequestHammerHit": {
            "$className": "RemoteEvent"
          },

          "CombatFeedback": {
            "$className": "RemoteEvent"
          }
        }
      }
    },

    "ServerScriptService": {
      "Main": {
        "$path": "src/server/Main.server.luau"
      },

      "Config": {
        "$className": "Folder",
        "$path": { "optional": "src/server/config" }
      },

      "Services": {
        "$className": "Folder",
        "$path": { "optional": "src/server/services" }
      },

      "Controllers": {
        "$className": "Folder",
        "$path": { "optional": "src/server/controllers" }
      }
    },

    "StarterPlayer": {
      "StarterPlayerScripts": {
        "Main": {
          "$path": "src/client/Main.client.luau"
        },

        "Controllers": {
          "$className": "Folder",
          "$path": { "optional": "src/client/controllers" }
        }
      }
    },

    "StarterGui": {
      "Screens": {
        "$className": "Folder",
        "$path": { "optional": "src/gui/screens" }
      }
    },

    "Lighting": {
      "$properties": {
        "Brightness": 2,
        "GlobalShadows": true
      }
    },

    "SoundService": {
      "$properties": {
        "RespectFilteringEnabled": true
      }
    }
  }
}